# Copy this file to ".env" and fill in your own key.
# NEVER commit .env  -- it is already listed in .gitignore.

# Required for the LLM dialogue layer. Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: which model to use. Defaults to the free Gemma tier if unset.
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free

# Optional: shown on your OpenRouter dashboard so you can tell runs apart.
OPENROUTER_APP_NAME=COMP4431-Group21-CampusNavigator

# Optional: turn the LLM layer off entirely (grammar-only mode).
# The app still works -- this is the offline demo path.
LLM_ENABLED=1

# Optional: seconds to wait for the model before falling back to the grammar parser.
LLM_TIMEOUT=20

# Level B: let the model write the reply sentence, using only numbers the route
# calculation produced. Set to 0 to go back to the plain template (Level A).
LLM_NARRATE=1
