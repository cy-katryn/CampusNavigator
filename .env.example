# Copy this file to ".env" and fill in your own key.
# NEVER commit .env  -- it is already listed in .gitignore.

# Required for the LLM dialogue layer. Get one at https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Optional: which model to use. Defaults to deepseek-chat if unset.
DEEPSEEK_MODEL=deepseek-chat

# Optional: turn the LLM layer off entirely (grammar-only mode).
# The app still works -- this is the offline demo path.
LLM_ENABLED=1

# Optional: seconds to wait for the model before falling back to the grammar parser.
LLM_TIMEOUT=20

# Level B: let the model write the reply sentence, using only numbers the route
# calculation produced. Set to 0 to go back to the plain template (Level A).
LLM_NARRATE=1

# --- place-name matching: embeddings + Pinecone (required) -----------------
# A place name is embedded and looked up by nearest neighbour in Pinecone. The
# keyword matchers are gone, so the app stops at startup if these are missing
# rather than guessing a place.
#
# GitHub Models' inference API was retired on 2026-07-30. Its token is still read
# as GITHUB_TOKEN, and EMBEDDINGS_BASE_URL repoints the same client at any
# OpenAI-compatible /embeddings endpoint (Azure AI Foundry, etc.).
GITHUB_TOKEN=
EMBEDDINGS_MODEL=openai/text-embedding-3-large
EMBEDDINGS_BASE_URL=https://models.github.ai/inference

# Get a key at https://app.pinecone.io and create the index with:
#   python tools/build.py embed
PINECONE_API_KEY=
PINECONE_INDEX=campus-navigator-places
PINECONE_NAMESPACE=
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Optional: cosine similarity below which a phrase matches nothing (0.35), and
# how many nearest neighbours come back per lookup (8).
PLACE_MIN_SIMILARITY=0.35
PLACE_TOP_K=8
