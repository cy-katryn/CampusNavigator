# Copy this file to ".env" and fill in your own keys.
#
# With an empty .env the app still runs: the grammar parser answers, and place names 
# are matched by the built-in scorer (campus_nav/lexical.py). Each key you add switches
# one layer to its better path.

# --- understanding: the assistant model -----------------------------
# Any OpenAI-compatible chat-completions endpoint works -- the client only needs
# {base_url}/chat/completions with tool calling. DeepSeek is the default.
#
#   LLM_BASE_URL=https://api.deepseek.com/v1     (default)
#   LLM_BASE_URL=https://api.openai.com/v1
#   LLM_BASE_URL=http://localhost:11434/v1       (a local server)
#
# DeepSeek key: https://platform.deepseek.com/api_keys
LLM_API_KEY=
LLM_MODEL=deepseek-chat
# Leave empty for the default endpoint.
LLM_BASE_URL=
# Older names, still honoured: DEEPSEEK_API_KEY and DEEPSEEK_MODEL.

# 0 = grammar only.
LLM_ENABLED=1
# Seconds to wait for the model before the grammar takes over.
LLM_TIMEOUT=20
# 0 = the plain template, no model phrasing.
LLM_NARRATE=1

# --- name identity: embeddings --------------------------------------
# Any OpenAI-compatible POST {base}/embeddings endpoint. The defaults are Alibaba Cloud
# Model Studio (DashScope). The model must be multilingual: a campus name is published 
# in English, Traditional Chinese and Simplified Chinese.

EMBEDDINGS_API_KEY=
EMBEDDINGS_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
EMBEDDINGS_MODEL=text-embedding-v4

# --- name identity: the vector index --------------------------------
# Get a key at https://app.pinecone.io, then fill the index once:
#   python tools/build.py embed --recreate
# --recreate is needed whenever the embedding model (and so the dimension) changes.
PINECONE_API_KEY=
PINECONE_INDEX=campus-navigator-places
# Optional: a namespace partitions one index into independent vector sets. Leave empty
# for the default namespace -- changing it after a build means queries find nothing.
PINECONE_NAMESPACE=
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Optional tuning: the cosine similarity below which a phrase matches nothing, and how
# many nearest neighbours come back per lookup.
PLACE_MIN_SIMILARITY=0.35
PLACE_TOP_K=8